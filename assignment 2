
import Foundation


// === Problem 1: FizzBuzz ===
func runFizzBuzz() {
    print("=== Problem 1: FizzBuzz ===")
    for i in 1...100 {
        if i % 15 == 0 {
            print("FizzBuzz")
        } else if i % 3 == 0 {
            print("Fizz")
        } else if i % 5 == 0 {
            print("Buzz")
        } else {
            print(i)
        }
    }
    print()
}

// === Problem 2: Prime Numbers ===
func runPrimeNumbers() {
    print("=== Problem 2: Prime Numbers ===")
    
    func isPrime(_ number: Int) -> Bool {
        if number < 2 { return false }
        for i in 2..<number {
            if number % i == 0 {
                return false
            }
        }
        return true
    }
    
    for i in 1...100 {
        if isPrime(i) {
            print(i, terminator: " ")
        }
    }
    print("\n")
}

// === Problem 3: Temperature Converter ===
func runTemperatureConverter() {
    print("=== Problem 3: Temperature Converter ===")
    print("Введите температуру и единицу (C/F/K), например: 25 C")
    
    if let input = readLine() {
        let parts = input.split(separator: " ")
        if parts.count == 2, let value = Double(parts[0]) {
            let unit = parts[1].uppercased()
            
            switch unit {
            case "C":
                let f = value * 9/5 + 32
                let k = value + 273.15
                print("\(value)°C = \(f)°F = \(k)K")
            case "F":
                let c = (value - 32) * 5/9
                let k = c + 273.15
                print("\(value)°F = \(c)°C = \(k)K")
            case "K":
                let c = value - 273.15
                let f = c * 9/5 + 32
                print("\(value)K = \(c)°C = \(f)°F")
            default:
                print("Неизвестная единица измерения")
            }
        } else {
            print("Неверный ввод")
        }
    }
    print()
}

// === Problem 4: Shopping List Manager ===
func runShoppingListManager() {
    print("=== Problem 4: Shopping List Manager ===")
    var shoppingList: [String] = []
    
    while true {
        print("Введите команду (add <товар>, remove <товар>, show, exit):")
        if let input = readLine() {
            let parts = input.split(separator: " ", maxSplits: 1).map { String($0) }
            if parts.isEmpty { continue }
            
            let command = parts[0].lowercased()
            switch command {
            case "add":
                if parts.count > 1 {
                    shoppingList.append(parts[1])
                    print("Добавлено: \(parts[1])")
                } else {
                    print("Укажите товар")
                }
            case "remove":
                if parts.count > 1, let index = shoppingList.firstIndex(of: parts[1]) {
                    shoppingList.remove(at: index)
                    print("Удалено: \(parts[1])")
                } else {
                    print("Товар не найден")
                }
            case "show":
                print("Список покупок: \(shoppingList)")
            case "exit":
                print("Выход из Shopping List Manager")
                return
            default:
                print("Неизвестная команда")
            }
        }
    }
}

// === Problem 5: Word Frequency Counter ===
func runWordFrequencyCounter() {
    print("=== Problem 5: Word Frequency Counter ===")
    print("Введите предложение:")
    
    if let input = readLine() {
        let words = input
            .lowercased()
            .components(separatedBy: CharacterSet.alphanumerics.inverted)
            .filter { !$0.isEmpty }
        
        var frequency: [String: Int] = [:]
        for word in words {
            frequency[word, default: 0] += 1
        }
        
        for (word, count) in frequency {
            print("\(word): \(count)")
        }
    }
    print()
}

// === Problem 6: Fibonacci Sequence ===
func runFibonacci() {
    print("=== Problem 6: Fibonacci Sequence ===")
    print("Введите количество чисел:")
    
    if let input = readLine(), let n = Int(input) {
        func fibonacci(_ n: Int) -> [Int] {
            if n <= 0 { return [] }
            if n == 1 { return [0] }
            var sequence = [0, 1]
            while sequence.count < n {
                sequence.append(sequence[sequence.count - 1] + sequence[sequence.count - 2])
            }
            return sequence
        }
        
        print(fibonacci(n))
    }
    print()
}

// === Problem 7: Grade Calculator ===
func runGradeCalculator() {
    print("=== Problem 7: Grade Calculator ===")
    var students: [String: Int] = [:]
    
    print("Введите имя и оценку (например: Ivan 90). Пустая строка = конец.")
    while let input = readLine(), !input.isEmpty {
        let parts = input.split(separator: " ")
        if parts.count == 2, let score = Int(parts[1]) {
            students[String(parts[0])] = score
        } else {
            print("Неверный ввод")
        }
    }
    
    let scores = Array(students.values)
    guard !scores.isEmpty else { return }
    
    let average = Double(scores.reduce(0, +)) / Double(scores.count)
    let maxScore = scores.max() ?? 0
    let minScore = scores.min() ?? 0
    
    print("Средний балл: \(average)")
    print("Максимум: \(maxScore)")
    print("Минимум: \(minScore)")
    
    for (name, score) in students {
        let status = Double(score) >= average ? "выше среднего" : "ниже среднего"
        print("\(name): \(score) (\(status))")
    }
    print()
}

// === Problem 8: Palindrome Checker ===
func runPalindromeChecker() {
    print("=== Problem 8: Palindrome Checker ===")
    print("Введите строку:")
    
    if let text = readLine() {
        let filtered = text.lowercased().filter { $0.isLetter }
        let isPalindrome = filtered == String(filtered.reversed())
        print(isPalindrome ? "Палиндром" : "Не палиндром")
    }
    print()
}

// === Problem 9: Simple Calculator ===
func runSimpleCalculator() {
    print("=== Problem 9: Simple Calculator ===")
    while true {
        print("Введите выражение (например: 5 + 3) или exit:")
        if let input = readLine(), !input.isEmpty {
            if input.lowercased() == "exit" { break }
            let parts = input.split(separator: " ")
            if parts.count == 3,
               let a = Double(parts[0]),
               let b = Double(parts[2]) {
                let op = parts[1]
                switch op {
                case "+":
                    print("\(a + b)")
                case "-":
                    print("\(a - b)")
                case "*":
                    print("\(a * b)")
                case "/":
                    if b != 0 {
                        print("\(a / b)")
                    } else {
                        print("Ошибка: деление на ноль")
                    }
                default:
                    print("Неизвестная операция")
                }
            } else {
                print("Неверный ввод")
            }
        }
    }
    print()
}

// === Problem 10: Unique Characters ===
func runUniqueCharacters() {
    print("=== Problem 10: Unique Characters ===")
    print("Введите строку:")
    
    if let text = readLine() {
        var seen: Set<Character> = []
        var hasUnique = true
        for char in text {
            if seen.contains(char) {
                hasUnique = false
                break
            }
            seen.insert(char)
        }
        print(hasUnique ? "Все символы уникальны" : "Есть повторяющиеся символы")
    }
    print()
}

